{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abtt-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abtt-db",
      "database_id": "e82f293e-4986-4013-bd06-002fa6fde3d4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "abtt-media"
    }
  ],
  "vars": {
    "ADMIN_USER": "admin"
  }
}
